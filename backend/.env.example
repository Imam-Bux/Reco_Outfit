# Backend environment variables
#
# COPY THIS FILE to .env for local development.
# For Vercel, set these in Vercel Dashboard > Project > Settings > Environment Variables.

PORT=5000

# Public URL of the shop logo used on receipts (the logo in the frontend public/ folder)
SHOP_LOGO_URL=https://<frontend-domain>.vercel.app/logo.svg

MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/reco_db

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=replace_with_a_long_random_secret

ADMIN_NAME=admin
ADMIN_SEED_PASSWORD=replace_with_a_strong_password